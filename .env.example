PORT=4000
HOST=0.0.0.0
# CORS_ORIGINS=*

# Supabase (required for real user auth + persistent store)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GEMINI_API_KEY=your-gemini-api-key
# Use the SAME value as Render frebob-backend → Environment → GEMINI_API_KEY.
# After changing this file, fully restart `npm run dev` (tsx watch does not reload .env).
# Optional — defaults to gemini-3.5-flash with automatic fallbacks
# GEMINI_MODEL=gemini-3.5-flash
# YARNGPT_API_KEY=your-yarngpt-bearer-token (TTS voice — YarnGPT)
